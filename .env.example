# ----------------------------------------
# LOAN TRACKER - ENVIRONMENT VARIABLES
# ----------------------------------------
# INSTRUCTIONS: Copy this file, rename it to .env, 
# and fill in your actual secure passwords.

# PostgreSQL Database Configuration
POSTGRES_USER=your_database_user
POSTGRES_PASSWORD=your_secure_password
POSTGRES_DB=loan_tracker

# Database Connection String (Used by Python/SQLAlchemy)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DB_NAME
DATABASE_URL=postgresql://your_database_user:your_secure_password@loan_tracker_db:5432/loan_tracker

# Backend Settings
# SECRET_KEY=your_random_secret_string_here
