# ----------------------------------------
# SHADOW-DEBT - ENVIRONMENT VARIABLES
# ----------------------------------------

# PostgreSQL Database Configuration
POSTGRES_USER=shadow_user
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=shadow_debt

# Backend Security (Make this a random 32+ character string)
SECRET_KEY=change_this_to_a_random_secret_key_for_jwt

# Note: We completely removed DATABASE_URL from here!
# The docker-compose.yml will now construct it automatically using the variables above.
